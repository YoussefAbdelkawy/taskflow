{
  "name": "taskflow",
  "version": "0.1.0",
  "private": true,
  "description": "Task and Project Management System - Software Construction & Testing, Winter 2026",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning src/data-access/database/seed.js",
    "build": "node scripts/build-assets.js",
    "build:css": "node scripts/build-assets.js css",
    "watch:css": "node scripts/build-assets.js watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:api": "node --disable-warning=ExperimentalWarning scripts/api-tests.js",
    "trace": "node scripts/traceability.js"
  },
  "dependencies": {
    "chart.js": "^4.6.2",
    "express": "^5.3.0",
    "swagger-ui-dist": "5.33.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.5",
    "basecoat-css": "^1.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "lucide-static": "^1.79.0",
    "newman": "^6.2.3",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.5"
  }
}
